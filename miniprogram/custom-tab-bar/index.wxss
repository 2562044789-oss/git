.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  height: 112rpx;
  padding: 8rpx 20rpx 2rpx;
  border-top: 1rpx solid rgba(86, 117, 96, 0.12);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 28rpx rgba(50, 87, 62, 0.05);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  color: #7e8c84;
  font-size: 21rpx;
}

.tab-item.active {
  color: #31875a;
  font-weight: 600;
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 48rpx;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.48;
}

.active .tab-icon {
  opacity: 1;
}

.publish-mark {
  position: absolute;
  top: -5rpx;
  right: 1rpx;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  background: #df7f32;
}
