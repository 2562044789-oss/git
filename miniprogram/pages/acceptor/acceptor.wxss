.acceptor-page {
  padding-top: 24rpx;
}

.acceptor-hero {
  padding: 34rpx 30rpx;
  border-radius: var(--radius);
  background: linear-gradient(135deg, #e7f6ec 0%, #f4fbf6 100%);
}

.acceptor-hero-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.acceptor-hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.acceptor-hero-sub {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.5;
}

.summary-card,
.form-card,
.state-card {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 30rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.summary-strong {
  color: var(--ink);
  font-weight: 600;
}

.reject-note {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  color: #a94747;
  background: #ffebeb;
  font-size: 24rpx;
}

.empty-card {
  margin-top: 24rpx;
  padding: 34rpx 28rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.form-title {
  margin-bottom: 24rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.photo-row {
  display: flex;
  gap: 20rpx;
}

.photo-box {
  position: relative;
  flex: 1;
  height: 200rpx;
  overflow: hidden;
  border: 1rpx dashed #b9d6c3;
  border-radius: 18rpx;
  background: var(--primary-pale);
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: var(--primary-strong);
  font-size: 24rpx;
}

.form-note {
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.form-submit {
  margin-top: 28rpx;
}

.state-title {
  font-size: 31rpx;
  font-weight: 700;
}

.state-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
}

.state-text {
  margin-top: 16rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.6;
}

.balance-line {
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 25rpx;
}

.balance-amount {
  color: var(--primary-strong);
  font-size: 30rpx;
  font-weight: 700;
}

.state-button {
  margin-top: 26rpx;
}

.policy-card {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--radius);
  background: var(--primary-soft);
}

.policy-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #ffffff;
  background: var(--primary);
  font-size: 28rpx;
  font-weight: 700;
}

.policy-title {
  color: var(--primary-strong);
  font-size: 27rpx;
  font-weight: 700;
}

.policy-text {
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.6;
}
