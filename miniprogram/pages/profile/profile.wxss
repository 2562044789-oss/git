.profile-page {
  padding-top: 10rpx;
}

.profile-header {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx 0;
  border-radius: 30rpx;
  background: #dff2e5;
}

.profile-glow {
  position: absolute;
  top: -90rpx;
  right: -70rpx;
  width: 270rpx;
  height: 270rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
}

.profile-main {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.84);
  border-radius: 50%;
  color: #ffffff;
  background: #4aa974;
  box-shadow: 0 12rpx 25rpx rgba(54, 125, 82, 0.16);
  font-size: 33rpx;
  font-weight: 700;
}

.profile-side {
  display: flex;
  min-width: 44rpx;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.profile-name {
  flex: 1;
  color: #20372a;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
  word-break: break-all;
}

.edit-button {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  min-width: 128rpx;
  height: 44rpx;
  margin-left: auto;
  padding: 0;
  border: 1rpx solid rgba(57, 126, 83, 0.25);
  border-radius: 999rpx;
  color: #397e56;
  background: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
  line-height: 44rpx;
}

.uid-row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.uid-label {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  color: #397e56;
  background: rgba(255, 255, 255, 0.7);
  font-size: 18rpx;
  font-weight: 750;
}

.uid-value {
  color: #567765;
  font-size: 22rpx;
  font-weight: 650;
}

.identity-details {
  position: relative;
  z-index: 2;
  display: flex;
  gap: 14rpx;
  margin-top: 26rpx;
}

.detail-chip {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 5rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(66, 113, 82, 0.1);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.52);
}

.credit-chip {
  flex: 0 0 148rpx;
  align-items: center;
}

.community-chip {
  display: flex !important;
  flex: 1;
  min-height: 82rpx;
  flex-direction: row !important;
  align-items: center !important;
  gap: 14rpx;
  padding: 18rpx 20rpx;
}

.community-chip .detail-label {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
}

.community-value {
  overflow: hidden;
  color: #294d36;
  font-size: 30rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.credit-chip .detail-label {
  font-size: 20rpx;
}

.credit-value {
  color: #2f8055;
  font-size: 34rpx;
}

.wallet-strip {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 30rpx;
  padding: 24rpx 0 26rpx;
  border-top: 1rpx solid rgba(73, 126, 92, 0.13);
}

.wallet-label {
  color: #65806e;
  font-size: 22rpx;
}

.wallet-value {
  margin-top: 3rpx;
  color: #235f3c;
  font-size: 40rpx;
  font-weight: 800;
}

.wallet-shortcut {
  color: #397e56;
  font-size: 23rpx;
  font-weight: 600;
}

.stats-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 25rpx 0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 9rpx 25rpx rgba(54, 99, 70, 0.04);
}

.stat-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 800;
}

.stat-label {
  color: #74857a;
  font-size: 22rpx;
}

.stat-line {
  width: 1rpx;
  height: 48rpx;
  background: #e1eae4;
}

.menu-card {
  margin-top: 20rpx;
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 122rpx;
  border-bottom: 1rpx solid #e7eee9;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  color: #38825a;
  background: #e7f5ec;
  font-size: 24rpx;
  font-weight: 800;
}

.menu-title {
  font-size: 27rpx;
  font-weight: 650;
}

.menu-subtitle {
  margin-top: 4rpx;
  color: #85928b;
  font-size: 21rpx;
}

.menu-arrow {
  color: #a1ada6;
  font-size: 38rpx;
}

.unread-dot {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #df6b5c;
  font-size: 19rpx;
  text-align: center;
  line-height: 34rpx;
}

.safety-note {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
  padding: 22rpx;
  border: 1rpx solid #dfeae2;
  border-radius: 20rpx;
  background: #f9fbf9;
}

.safety-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #75b58c;
  font-size: 22rpx;
}

.safety-title {
  font-size: 24rpx;
  font-weight: 700;
}

.safety-text {
  margin-top: 4rpx;
  color: #77877e;
  font-size: 21rpx;
}

.profile-uid {
  margin-top: 7rpx;
  color: #4f7c61;
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 0;
}

/* 接单员认证卡片：接单资格是可用性的前置条件，放在统计数据下方显著位置 */
.certify-card {
  margin-top: 20rpx;
  padding: 26rpx 28rpx;
}

.certify-card.certified {
  border-color: rgba(74, 169, 116, 0.28);
  background: linear-gradient(135deg, #f2fbf5 0%, #ffffff 70%);
}

.certify-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.certify-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: var(--primary);
  font-size: 30rpx;
  font-weight: 700;
}

.certify-title {
  font-size: 29rpx;
  font-weight: 700;
}

.certify-subtitle {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.certify-button {
  margin-top: 22rpx;
}
