<view class="page complaint-page page-no-tab">
  <view wx:if="{{formOpen}}">
    <view class="page-title">发起投诉</view>
    <view class="page-subtitle">请如实描述问题并保留相关凭证</view>

    <view wx:if="{{order}}" class="order-brief card">
      <view class="brief-label">关联订单</view>
      <view class="brief-title">{{order.title}}</view>
      <view class="brief-no">{{order.order_no}} · ¥{{order.amount}}</view>
    </view>

    <view class="form-card card">
      <view class="field">
        <text class="field-label">投诉原因</text>
        <view class="reason-list">
          <view
            wx:for="{{reasons}}"
            wx:key="*this"
            class="reason-item {{form.reason === item ? 'active' : ''}}"
            data-reason="{{item}}"
            bindtap="selectReason"
          >
            <view class="reason-check">{{form.reason === item ? '✓' : ''}}</view>
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">详细说明</text>
        <textarea
          class="textarea"
          maxlength="500"
          value="{{form.description}}"
          placeholder="请描述事情经过、沟通情况和你的诉求"
          placeholder-class="input-placeholder"
          bindinput="updateDescription"
        />
        <view class="form-note">{{form.description.length}} / 500</view>
      </view>

      <view class="field">
        <text class="field-label">上传凭证</text>
        <view class="proof-list">
          <view wx:for="{{form.images}}" wx:key="*this" class="proof-item">
            <image src="{{item}}" mode="aspectFill"></image>
            <view class="remove-proof" data-index="{{index}}" bindtap="removeImage">×</view>
          </view>
          <view wx:if="{{form.images.length < 3}}" class="proof-add" bindtap="chooseImages">
            <text>＋</text>
            <view>添加图片</view>
          </view>
        </view>
      </view>
    </view>

    <view class="process-note">
      提交后管理员将在 24 小时内介入，处理结果会通过消息中心通知双方。
    </view>
    <button class="primary-button submit-button" loading="{{submitting}}" bindtap="submit">提交投诉</button>
  </view>

  <view wx:else>
    <view class="page-title">投诉记录</view>
    <view class="page-subtitle">查看已提交和收到的投诉处理情况</view>
    <view wx:if="{{complaints.length}}" class="complaint-list">
      <view wx:for="{{complaints}}" wx:key="id" class="complaint-card card">
        <view class="row-between">
          <view class="complaint-reason">{{item.reason}}</view>
          <view class="status {{item.statusClass}}">{{item.statusText}}</view>
        </view>
        <view class="complaint-task">{{item.task_title}}</view>
        <view class="complaint-desc">{{item.description}}</view>
        <view class="complaint-result">
          <text>处理结果</text>
          <text>{{item.handle_result || '管理员正在处理中'}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty card">
      <view class="empty-symbol">诉</view>
      <view class="empty-title">暂无投诉记录</view>
      <view>优先沟通协商，必要时再发起投诉</view>
    </view>
  </view>
</view>
