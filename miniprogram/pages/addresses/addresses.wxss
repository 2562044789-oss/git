.address-page {
  padding-top: 18rpx;
}

.page-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.add-button {
  padding: 14rpx 20rpx;
  border-radius: 15rpx;
  color: #ffffff;
  background: #4aa974;
  font-size: 24rpx;
  font-weight: 650;
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}

.address-card {
  padding: 26rpx;
}

.address-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contact {
  font-size: 29rpx;
  font-weight: 700;
}

.contact text {
  margin-left: 12rpx;
  color: #76847c;
  font-size: 23rpx;
  font-weight: 400;
}

.default-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #34835a;
  background: #e5f4ea;
  font-size: 20rpx;
  font-weight: 650;
}

.address-text {
  margin-top: 15rpx;
  color: #52655a;
  font-size: 25rpx;
  line-height: 1.55;
}

.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: 30rpx;
  margin-top: 20rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid #e7eee9;
  color: #34835a;
  font-size: 23rpx;
}

.address-actions .delete {
  color: #b45656;
}

.editor-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(22, 37, 28, 0.42);
}

.editor-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  max-height: 86vh;
  overflow-y: auto;
  padding: 28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 750;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #6f7e75;
  background: #f0f5f1;
  font-size: 38rpx;
}

.two-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.default-row {
  display: flex;
  align-items: center;
  gap: 13rpx;
  margin: 2rpx 0 28rpx;
  color: #52655a;
  font-size: 25rpx;
}

.default-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #c7d7cc;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 22rpx;
}

.default-check.checked {
  border-color: #4aa974;
  background: #4aa974;
}

.empty-symbol {
  margin-bottom: 12rpx;
  color: #a8c9b5;
  font-size: 74rpx;
  font-weight: 800;
}

.address-type-row {
  display: flex;
  gap: 14rpx;
}

.address-type-option {
  display: flex;
  flex: 1;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dce8df;
  border-radius: 15rpx;
  color: #64766b;
  background: #f9fbf9;
  font-size: 23rpx;
}

.address-type-option.active {
  border-color: #4aa974;
  color: #2f8055;
  background: #e7f5ec;
  font-weight: 700;
}

.address-type-tag {
  display: inline-flex;
  margin-top: 7rpx;
  padding: 3rpx 9rpx;
  border-radius: 8rpx;
  color: #376e51;
  background: #edf7f0;
  font-size: 19rpx;
}
