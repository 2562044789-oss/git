.order-detail-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.status-hero {
  padding: 34rpx 30rpx 42rpx;
  background: #dff3e6;
}

.status-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  color: #617568;
  font-size: 21rpx;
}

.status-title {
  margin-top: 25rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.status-tip {
  margin-top: 10rpx;
  color: #617568;
  font-size: 24rpx;
}

.detail-body {
  padding: 24rpx 28rpx;
}

.timeline-card,
.route-card,
.evidence-card,
.people-card,
.completion-card {
  margin-bottom: 22rpx;
  padding: 27rpx;
}

.card-title {
  margin-bottom: 24rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.timeline-step {
  display: grid;
  grid-template-columns: 50rpx 1fr;
  min-height: 86rpx;
}

.step-axis {
  position: relative;
}

.step-dot {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: 3rpx solid #d7e3da;
  border-radius: 50%;
  color: #a3afa7;
  background: #ffffff;
  font-size: 20rpx;
}

.done .step-dot {
  border-color: #4aa974;
  color: #ffffff;
  background: #4aa974;
}

.step-line {
  position: absolute;
  top: 37rpx;
  bottom: -2rpx;
  left: 17rpx;
  width: 3rpx;
  background: #dce8df;
}

.done .step-line {
  background: #8ac6a0;
}

.step-title {
  color: #586a5f;
  font-size: 25rpx;
  font-weight: 600;
}

.done .step-title {
  color: #273d30;
}

.step-time {
  margin-top: 5rpx;
  color: #98a49d;
  font-size: 20rpx;
}

.task-name {
  font-size: 29rpx;
  font-weight: 700;
}

.task-description {
  margin-top: 8rpx;
  color: #697a70;
  font-size: 24rpx;
}

.route-box {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 17rpx;
  background: #f7faf7;
}

.route-row {
  display: grid;
  grid-template-columns: 18rpx 1fr;
  gap: 12rpx;
}

.route-point {
  width: 14rpx;
  height: 14rpx;
  margin-top: 9rpx;
  border-radius: 50%;
}

.route-point.start {
  background: #4aa974;
}

.route-point.end {
  background: #d8904d;
}

.route-connector {
  width: 2rpx;
  height: 34rpx;
  margin: -2rpx 0 -2rpx 6rpx;
  background: #cbd9cf;
}

.route-label {
  color: #8b978f;
  font-size: 20rpx;
}

.route-value {
  margin-top: 2rpx;
  font-size: 25rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 60rpx;
  color: #7c8981;
  font-size: 23rpx;
}

.meta-row > text:last-child {
  color: #35483c;
}

.person-row {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 12rpx 0;
}

.person-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: #6fb78a;
  font-size: 24rpx;
  font-weight: 700;
}

.person-avatar.acceptor {
  background: #5c9c91;
}

.person-name {
  font-size: 26rpx;
  font-weight: 650;
}

.person-role {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #3b7e58;
  background: #e8f5ec;
  font-size: 19rpx;
}

.contact-link {
  margin-top: 16rpx;
  color: #31875a;
  font-size: 24rpx;
  font-weight: 600;
  text-align: left;
}

.completion-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.small-action {
  width: 220rpx;
  height: 76rpx;
}

.plain-action {
  padding: 0 20rpx;
  color: #a15050;
  font-size: 24rpx;
}

.bottom-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e1eae4;
  background: rgba(255, 255, 255, 0.98);
}

.action-main {
  flex: 1;
}

.cancel-action {
  flex: 0 0 180rpx;
  height: 88rpx;
}

.detail-loading {
  padding-top: 35rpx;
}

.loading-card {
  height: 400rpx;
  border-radius: 24rpx;
  background: #e7efe9;
}

.loading-card.short {
  height: 220rpx;
  margin-top: 22rpx;
}

.evidence-tip {
  margin: -8rpx 0 18rpx;
  color: #708077;
  font-size: 22rpx;
}

.evidence-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.evidence-grid image {
  width: calc((100% - 28rpx) / 3);
  height: 190rpx;
  border-radius: 16rpx;
  background: #edf4ef;
}
