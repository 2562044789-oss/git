<view class="page announcement-page page-no-tab">
  <view class="page-title">社区公告</view>
  <view class="page-subtitle">共 {{total}} 条通知，点击查看全文</view>

  <view wx:if="{{list.length}}" class="notice-list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="notice-card card"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="notice-card-head">
        <view class="notice-card-title">{{item.title}}</view>
        <view class="notice-card-date">{{item.dateText}}</view>
      </view>
      <view class="notice-card-body">{{item.content}}</view>
      <view class="notice-card-more">查看全文 ›</view>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty card">
    <view class="empty-symbol">告</view>
    <view class="empty-title">暂无公告</view>
    <view>管理员发布后会自动出现在这里</view>
  </view>
</view>
