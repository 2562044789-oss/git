.home-page {
  padding-top: 16rpx;
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 6rpx 2rpx 28rpx;
}

.location {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.location-dot {
  width: 16rpx;
  height: 16rpx;
  border: 5rpx solid #d9efe1;
  border-radius: 50%;
  background: #46a66f;
}

.greeting {
  margin-top: 7rpx;
  color: #718078;
  font-size: 24rpx;
}

.notice-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border: 1rpx solid #e0ebe3;
  border-radius: 50%;
  background: #ffffff;
}

.bell-shape {
  position: relative;
  width: 25rpx;
  height: 26rpx;
  border: 3rpx solid #41614e;
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
  border-bottom: 0;
}

.bell-shape::after {
  content: "";
  position: absolute;
  right: -7rpx;
  bottom: -5rpx;
  left: -7rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #41614e;
}

.notice-badge {
  position: absolute;
  top: -5rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 7rpx;
  border: 3rpx solid #f3f8f4;
  border-radius: 999rpx;
  color: #ffffff;
  background: #df6b5c;
  font-size: 19rpx;
  line-height: 27rpx;
}

/* swiper 不会按内容自适应高度，必须给死。430rpx ≈ 卡片内容自然高度再加一点富余，
   防止窄屏上文案换到 2 行后被裁掉。 */
.hero-swiper {
  height: 430rpx;
}

.hero-band {
  position: relative;
  height: 100%;
  overflow: hidden;
  padding: 38rpx 34rpx;
  border-radius: 30rpx;
}

.hero-band-publish {
  color: #173b27;
  background: #dff3e5;
}

/* 三张广告各用不同底色：滑动切换时视觉边界清楚，用户能立刻看出"换了一屏" */
.hero-band-earn {
  color: #ffffff;
  background: #3f9d69;
}

.hero-band-safe {
  color: #4a3520;
  background: #fdf3e0;
}

.hero-band-earn .hero-kicker {
  color: rgba(255, 255, 255, 0.78);
}

.hero-band-safe .hero-kicker {
  color: #b4813a;
}

.hero-band-earn .hero-copy {
  color: rgba(255, 255, 255, 0.88);
}

.hero-band-safe .hero-copy {
  color: #8a6f4d;
}

/* 第 2、3 张的大号半透明字符当插画用，与第 1 张的天际线保持相近的视觉重心 */
.hero-glyph {
  position: absolute;
  right: 24rpx;
  bottom: -26rpx;
  z-index: 1;
  font-size: 220rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-band-earn .hero-glyph {
  color: rgba(255, 255, 255, 0.18);
}

.hero-band-safe .hero-glyph {
  color: rgba(217, 155, 63, 0.22);
}

/* 圆点指示器做在 swiper 外面：内置指示点在深绿底上看不清，
   放外面还能避开遮住卡片底部插画的问题。 */
.hero-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #c8dccf;
  transition: width 0.24s ease, background 0.24s ease;
}

.hero-dot.active {
  width: 32rpx;
  background: #3f9d69;
}

.hero-content {
  position: relative;
  z-index: 3;
  width: 61%;
}

.hero-kicker {
  margin-bottom: 12rpx;
  color: #4b8863;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-title {
  font-size: 43rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-copy {
  margin-top: 16rpx;
  color: #5f7968;
  font-size: 23rpx;
  line-height: 1.55;
}

.hero-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  /* 用 min-width 而不是写死 width：第 3 张的按钮文案更长（"去逛任务大厅"），
     固定宽度会把文字挤换行。min-width 让四字按钮保持和第 1 张一样宽。 */
  min-width: 205rpx;
  height: 72rpx;
  margin-top: 24rpx;
  padding: 0 26rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #3f9d69;
  box-shadow: 0 12rpx 24rpx rgba(63, 157, 105, 0.2);
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* 深绿底上用白底配绿字；米色底上用琥珀色 */
.hero-action-light {
  color: #2f7d52;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(24, 74, 48, 0.18);
}

.hero-action-amber {
  color: #ffffff;
  background: #d99b3f;
  box-shadow: 0 12rpx 24rpx rgba(217, 155, 63, 0.22);
}

.arrow {
  margin-left: 14rpx;
  font-size: 38rpx;
  font-weight: 300;
}

.hero-illustration {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 42%;
  height: 100%;
}

.sun-disc {
  position: absolute;
  top: 44rpx;
  right: 74rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #f6d77b;
}

.building {
  position: absolute;
  bottom: 44rpx;
  border-radius: 10rpx 10rpx 0 0;
  background: #ffffff;
  box-shadow: 0 9rpx 20rpx rgba(54, 99, 70, 0.09);
}

.building-left {
  right: 145rpx;
  width: 95rpx;
  height: 170rpx;
}

.building-right {
  right: 29rpx;
  width: 126rpx;
  height: 225rpx;
}

.window-row {
  display: flex;
  justify-content: space-around;
  margin: 30rpx 12rpx 0;
}

.window-row text {
  width: 20rpx;
  height: 23rpx;
  border-radius: 3rpx;
  background: #b9dfc7;
}

.tree {
  position: absolute;
  z-index: 2;
  width: 55rpx;
  height: 76rpx;
  border-radius: 50% 50% 44% 44%;
  background: #76bd8e;
}

.tree::after {
  content: "";
  position: absolute;
  bottom: -28rpx;
  left: 23rpx;
  width: 9rpx;
  height: 38rpx;
  background: #64866f;
}

.tree-one {
  right: 176rpx;
  bottom: 52rpx;
}

.tree-two {
  right: 137rpx;
  bottom: 31rpx;
  width: 44rpx;
  height: 62rpx;
}

.path {
  position: absolute;
  right: -30rpx;
  bottom: -45rpx;
  width: 220rpx;
  height: 95rpx;
  border-radius: 50%;
  background: #f1f7ee;
}

.announcement-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e1ebe4;
  border-radius: 18rpx;
  background: #ffffff;
}

.announcement-label {
  flex: none;
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  color: #397e56;
  background: #e3f4e9;
  font-size: 21rpx;
  font-weight: 700;
}

.announcement-copy {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.category-item {
  width: calc((100% - 36rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 6rpx 20rpx;
  border: 1rpx solid rgba(89, 126, 101, 0.1);
  border-radius: 20rpx;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.category-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  font-size: 31rpx;
  font-weight: 800;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.task-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx;
}

.task-accent {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 8rpx;
}

.distance {
  color: #7c8b83;
  font-size: 23rpx;
}

.task-title {
  margin-top: 20rpx;
  overflow: hidden;
  font-size: 33rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-description {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #607168;
  font-size: 25rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.task-route {
  display: grid;
  grid-template-columns: 16rpx 1fr;
  gap: 8rpx 13rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 15rpx;
  background: #f7faf7;
}

.route-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 50%;
}

.route-dot.start {
  background: #4aa974;
}

.route-dot.end {
  background: #d8904d;
}

.route-line {
  grid-column: 1;
  grid-row: 2;
  justify-self: center;
  width: 2rpx;
  height: 22rpx;
  margin-top: -11rpx;
  background: #cbdad0;
}

.route-text {
  grid-column: 2;
}

.route-text + .route-dot {
  grid-row: 3;
}

.route-text {
  overflow: hidden;
  color: #55675d;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta {
  gap: 9rpx;
  overflow: hidden;
  color: #7c8b83;
  font-size: 22rpx;
}

.mini-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #78b88f;
  font-size: 17rpx;
}

.dot-separator {
  color: #b3beb7;
}

/* 首页接单员招募滚动条。
   底色取与 hero 主按钮同源的绿色，和下方白色公告条明确区分：
   它是"广告"，要比公告更抢眼，但不能压过主 CTA"发布跑腿"。 */
.acceptor-ad {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #3f9d69;
  box-shadow: 0 12rpx 24rpx rgba(63, 157, 105, 0.18);
}

.acceptor-ad-hover {
  opacity: 0.92;
}

.acceptor-ad-badge {
  flex: none;
  padding: 6rpx 13rpx;
  border-radius: 10rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.acceptor-ad-window {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 40rpx;
  overflow: hidden;
}

/* 文字放两份，整体左移到 -50% 时第二份刚好接上第一份，形成无缝循环 */
.acceptor-ad-track {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  align-items: center;
  height: 100%;
  animation: acceptor-ad-scroll 22s linear infinite;
}

.acceptor-ad-text {
  display: block;
  flex: none;
  padding-right: 96rpx;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

@keyframes acceptor-ad-scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

.acceptor-ad-fade {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 36rpx;
}

.acceptor-ad-fade.left {
  left: 0;
  background: linear-gradient(90deg, #3f9d69 0%, rgba(63, 157, 105, 0) 100%);
}

.acceptor-ad-fade.right {
  right: 0;
  background: linear-gradient(270deg, #3f9d69 0%, rgba(63, 157, 105, 0) 100%);
}

.acceptor-ad-cta {
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #2f7d52;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
}
