<view class="page home-page">
  <view class="top-row">
    <view>
      <view class="location"><text class="location-dot"></text>阳光社区</view>
      <view class="greeting">{{user ? user.nickname : '邻里'}}，今天也来搭把手</view>
    </view>
    <button class="notice-button" bindtap="goMessages">
      <view class="bell-shape"></view>
      <view wx:if="{{unread}}" class="notice-badge">{{unread > 9 ? '9+' : unread}}</view>
    </button>
  </view>

  <!-- 首页广告轮播。用原生 swiper：滑动手势、惯性和循环播放由基础库实现，
       比手写 touch 事件稳。三张各用不同底色，滑到下一张时视觉边界清楚。 -->
  <swiper
    class="hero-swiper"
    autoplay="{{true}}"
    circular="{{true}}"
    interval="5200"
    duration="420"
    bindchange="onHeroChange"
  >
    <swiper-item>
      <view class="hero-band hero-band-publish">
        <view class="hero-content">
          <view class="hero-kicker">SUNSHINE NEIGHBORHOOD</view>
          <view class="hero-title">顺路帮个忙，<br />让邻里更近一步</view>
          <view class="hero-copy">发布一件小事，等待邻里接单，费用托管更安心。</view>
          <button class="hero-action" bindtap="goPublish">
            <text>发布跑腿</text>
            <text class="arrow">›</text>
          </button>
        </view>
        <view class="hero-illustration" aria-hidden="true">
          <view class="sun-disc"></view>
          <view class="building building-left">
            <view class="window-row"><text></text><text></text></view>
            <view class="window-row"><text></text><text></text></view>
          </view>
          <view class="building building-right">
            <view class="window-row"><text></text><text></text><text></text></view>
            <view class="window-row"><text></text><text></text><text></text></view>
          </view>
          <view class="tree tree-one"></view>
          <view class="tree tree-two"></view>
          <view class="path"></view>
        </view>
      </view>
    </swiper-item>

    <!-- 第 2 张：接单员招募。按钮文案跟认证进度走（已认证的人给"查看权益"，
         不该再劝他去申请），CTA 文案与认证页口径一致。 -->
    <swiper-item>
      <view class="hero-band hero-band-earn">
        <view class="hero-glyph">¥</view>
        <view class="hero-content">
          <view class="hero-kicker">SUNSHINE EARN</view>
          <view class="hero-title">顺路接单，<br />零碎时间换报酬</view>
          <view class="hero-copy">
            实名认证 + 保证金 ¥{{acceptorAd.deposit}}（退出可退），审核通过即可接单。
          </view>
          <button class="hero-action hero-action-light" bindtap="goAcceptor">
            <text>{{acceptorAd.cta}}</text>
            <text class="arrow">›</text>
          </button>
        </view>
      </view>
    </swiper-item>

    <!-- 第 3 张：回答"钱安不安全"，给不想发布、只想先看看的人一个去处 -->
    <swiper-item>
      <view class="hero-band hero-band-safe">
        <view class="hero-glyph">✓</view>
        <view class="hero-content">
          <view class="hero-kicker">SAFE TRADE</view>
          <view class="hero-title">报酬先托管，<br />完成再结算</view>
          <view class="hero-copy">
            发布者下单即冻结报酬，确认完成后才打给接单员，双方都安心。
          </view>
          <button class="hero-action hero-action-amber" bindtap="goCategories">
            <text>去逛任务大厅</text>
            <text class="arrow">›</text>
          </button>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 圆点自己画：swiper 内置指示点在深绿底上看不清 -->
  <view class="hero-dots">
    <view
      wx:for="{{heroDots}}"
      wx:key="*this"
      class="hero-dot {{heroIndex === item ? 'active' : ''}}"
    ></view>
  </view>

  <view wx:if="{{announcements.length}}" class="announcement-board">
    <view class="announcement-board-head">
      <view class="announcement-label">社区公告</view>
      <view class="announcement-more" bindtap="goAnnouncements">全部 {{announcementTotal}} 条 ›</view>
    </view>
    <view
      wx:for="{{announcements}}"
      wx:key="id"
      class="announcement-item"
      data-id="{{item.id}}"
      bindtap="goAnnouncement"
    >
      <view class="announcement-item-main">
        <view class="announcement-item-title">{{item.title}}</view>
        <view class="announcement-item-date">{{item.dateText}}</view>
      </view>
      <text class="announcement-item-chevron">›</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">快捷服务</view>
      <view class="section-link" bindtap="goCategories">全部服务</view>
    </view>
    <view class="category-grid">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-item"
        data-id="{{item.id}}"
        bindtap="goCategory"
      >
        <view class="category-icon" style="background: {{item.color}}18; color: {{item.color}};">
          {{item.shortText}}
        </view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">附近急单</view>
        <view class="page-subtitle">按发布时间为你推荐</view>
      </view>
      <view class="section-link" bindtap="goCategories">查看更多</view>
    </view>
    <view class="task-list">
      <view
        wx:for="{{tasks}}"
        wx:key="id"
        class="task-card card"
        data-id="{{item.id}}"
        bindtap="goTask"
      >
        <view class="task-accent" style="background: {{item.category_color || '#4AA974'}};"></view>
        <view class="row-between">
          <view class="tag">{{item.category_name}}</view>
          <view class="distance">{{item.distance_km}} km</view>
        </view>
        <view class="task-title">{{item.title}}</view>
        <view class="task-description">{{item.description}}</view>
        <view class="task-route">
          <view class="route-dot start"></view>
          <view class="route-text">{{item.pickup_address}}</view>
          <view class="route-line"></view>
          <view class="route-dot end"></view>
          <view class="route-text">{{item.delivery_address}}</view>
        </view>
        <view class="divider"></view>
        <view class="row-between">
          <view class="row task-meta">
            <view class="mini-avatar">{{item.publisherInitials}}</view>
            <text>{{item.publisher_name}}</text>
            <text class="dot-separator">·</text>
            <text>{{item.timeText}} 前完成</text>
          </view>
          <view class="money">{{item.reward}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
