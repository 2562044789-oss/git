.publish-page {
  padding-top: 18rpx;
}

.form-card {
  margin-top: 30rpx;
  padding: 8rpx 26rpx;
}

.form-section {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #e7eee9;
}

.form-section:last-child {
  border-bottom: 0;
}

.form-section-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 26rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 13rpx;
  color: #ffffff;
  background: #4aa974;
  font-size: 23rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15rpx;
}

.category-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 8rpx;
  border: 1rpx solid #e3ebe5;
  border-radius: 17rpx;
  color: #5f7066;
  font-size: 23rpx;
}

.category-option.active {
  border-color: #4aa974;
  color: #287a4d;
  background: #e8f6ed;
  font-weight: 700;
}

.category-letter {
  font-size: 34rpx;
  font-weight: 800;
}

.two-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.picker.placeholder {
  color: #a6b0aa;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.image-item,
.image-add {
  position: relative;
  width: 164rpx;
  height: 164rpx;
  overflow: hidden;
  border-radius: 18rpx;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.remove-image {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  color: #ffffff;
  background: rgba(27, 43, 34, 0.7);
  font-size: 28rpx;
}

.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #bfd5c7;
  color: #73917d;
  background: #f7faf8;
  font-size: 22rpx;
}

.image-add-plus {
  margin-bottom: 3rpx;
  font-size: 48rpx;
  font-weight: 300;
}

.quick-rewards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.reward-option,
.reward-input-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border: 1rpx solid #dce8df;
  border-radius: 16rpx;
  color: #5d6e64;
  background: #ffffff;
  font-size: 27rpx;
}

.reward-option.active {
  border-color: #4aa974;
  color: #287a4d;
  background: #e7f5ec;
  font-weight: 700;
}

.reward-input-wrap {
  grid-column: 1 / span 2;
  padding: 0 16rpx;
  color: #d77f34;
}

.reward-input {
  width: 100%;
  text-align: center;
  color: #d77f34;
}

.escrow-note {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #eef8f1;
}

.shield-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #4aa974;
  font-size: 24rpx;
  font-weight: 700;
}

.escrow-title {
  color: #2e764f;
  font-size: 25rpx;
  font-weight: 700;
}

.escrow-text {
  margin-top: 4rpx;
  color: #6b8073;
  font-size: 22rpx;
}

.submit-button {
  margin-top: 30rpx;
}

.field-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.field-label-row .field-label {
  margin-bottom: 0;
}

.address-select-link {
  color: #31875a;
  font-size: 22rpx;
  font-weight: 600;
}

.address-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(22, 37, 28, 0.42);
}

.address-picker {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  max-height: 76vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 45rpx rgba(32, 64, 43, 0.16);
}

.address-picker-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.address-picker-title {
  color: #20372a;
  font-size: 33rpx;
  font-weight: 800;
}

.address-picker-subtitle {
  margin-top: 6rpx;
  color: #87968d;
  font-size: 22rpx;
}

.address-picker-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  color: #6f7e75;
  background: #f0f5f1;
  font-size: 38rpx;
}

.address-picker-list {
  max-height: 48vh;
}

.address-option {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e7eee9;
}

.address-option-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-contact {
  color: #2d4436;
  font-size: 27rpx;
  font-weight: 700;
}

.address-default {
  padding: 4rpx 11rpx;
  border-radius: 999rpx;
  color: #34835a;
  background: #e5f4ea;
  font-size: 19rpx;
}

.address-full {
  margin-top: 8rpx;
  color: #6d7e74;
  font-size: 23rpx;
  line-height: 1.55;
}

.address-empty {
  padding: 70rpx 20rpx;
  color: #87968d;
  font-size: 24rpx;
  text-align: center;
}

.address-manage-button {
  width: 100%;
  margin-top: 22rpx;
}
