.detail-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
}

.detail-hero {
  padding: 34rpx 30rpx 38rpx;
  background: #dff3e6;
}

.distance {
  color: #567565;
  font-size: 24rpx;
}

.detail-title {
  margin-top: 25rpx;
  font-size: 43rpx;
  font-weight: 800;
  line-height: 1.35;
}

.reward-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 30rpx;
}

.reward-label {
  color: #66806f;
  font-size: 22rpx;
}

.detail-money {
  margin-top: 3rpx;
  color: #d9792e;
  font-size: 49rpx;
  font-weight: 800;
}

.detail-body {
  padding: 24rpx 28rpx;
}

.info-card {
  margin-bottom: 22rpx;
  padding: 27rpx;
}

.info-title {
  font-size: 30rpx;
  font-weight: 700;
}

.description {
  margin-top: 17rpx;
  color: #4f6257;
  font-size: 27rpx;
  line-height: 1.7;
}

.task-images {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.task-images image {
  width: 190rpx;
  height: 190rpx;
  border-radius: 16rpx;
}

.address-timeline {
  margin-top: 24rpx;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 25rpx 1fr;
  gap: 14rpx;
  min-height: 80rpx;
}

.timeline-point {
  width: 16rpx;
  height: 16rpx;
  margin-top: 9rpx;
  border: 4rpx solid #d8eee0;
  border-radius: 50%;
}

.timeline-point.start {
  background: #4aa974;
}

.timeline-point.end {
  background: #d8904d;
}

.timeline-line {
  position: absolute;
  top: 31rpx;
  bottom: -3rpx;
  left: 7rpx;
  width: 2rpx;
  background: #cad9cf;
}

.timeline-label {
  color: #829087;
  font-size: 21rpx;
}

.timeline-address {
  margin-top: 4rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 62rpx;
  color: #738178;
  font-size: 24rpx;
}

.detail-row > text:last-child {
  color: #34473b;
}

.poster-line {
  gap: 9rpx;
  color: #34473b;
}

.mini-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #78b88f;
  font-size: 16rpx;
}

.credit {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #3d8059;
  background: #e7f5ec;
  font-size: 18rpx;
}

.security-card {
  display: flex;
  gap: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #dce9df;
  border-radius: 20rpx;
  background: #f8fbf9;
}

.security-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #74b58c;
  font-size: 22rpx;
  font-weight: 700;
}

.security-title {
  font-size: 24rpx;
  font-weight: 700;
}

.security-text {
  margin-top: 4rpx;
  color: #78877f;
  font-size: 21rpx;
}

.bottom-action {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e1eae4;
  background: rgba(255, 255, 255, 0.98);
}

.contact-button,
.accept-button {
  height: 88rpx;
}

.contact-button {
  display: flex;
  flex: 0 0 210rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #cfe2d5;
  border-radius: 18rpx;
  color: #34835a;
  background: #f2f8f4;
  font-size: 27rpx;
  font-weight: 600;
}

.accept-button {
  flex: 1;
}

.detail-loading {
  padding-top: 40rpx;
}

.loading-block {
  height: 380rpx;
  border-radius: 24rpx;
  background: #e6efe8;
}

.loading-block.short {
  height: 210rpx;
  margin-top: 24rpx;
}

.contact-button.disabled {
  color: #87968d;
  background: #f1f4f2;
}
