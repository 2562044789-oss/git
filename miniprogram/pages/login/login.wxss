page {
  background: #eef8f1;
}

.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: 90rpx 42rpx 50rpx;
  background: #eef8f1;
}

.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 126rpx;
  border-radius: 38rpx;
  color: #ffffff;
  background: #46a46f;
  box-shadow: 0 22rpx 48rpx rgba(70, 164, 111, 0.24);
  font-size: 52rpx;
  font-weight: 800;
}

.brand-name {
  margin-top: 28rpx;
  color: #20372a;
  font-size: 40rpx;
  font-weight: 800;
}

.brand-copy {
  margin-top: 10rpx;
  color: #6d8375;
  font-size: 24rpx;
}

.login-card {
  margin-top: 72rpx;
  padding: 42rpx 34rpx 36rpx;
  border: 1rpx solid rgba(76, 122, 92, 0.12);
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(48, 92, 65, 0.08);
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 800;
}

.welcome-subtitle {
  margin-top: 8rpx;
  color: #87968d;
  font-size: 23rpx;
}

.field {
  margin-top: 34rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #53675b;
  font-size: 24rpx;
  font-weight: 600;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dce8df;
  border-radius: 18rpx;
  color: #1d3025;
  background: #f8fbf9;
  font-size: 28rpx;
}

.wechat-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  height: 92rpx;
  margin-top: 34rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: #46a46f;
  box-shadow: 0 14rpx 30rpx rgba(70, 164, 111, 0.22);
  font-size: 29rpx;
  font-weight: 700;
}

.wechat-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #46a46f;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
}

.agreement {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  color: #7b8981;
  font-size: 21rpx;
  line-height: 1.5;
}

.agreement-check {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-top: 1rpx;
  border: 2rpx solid #c6d5ca;
  border-radius: 50%;
  color: #ffffff;
  font-size: 19rpx;
}

.agreement-check.checked {
  border-color: #46a46f;
  background: #46a46f;
}

.login-footer {
  margin-top: 60rpx;
  color: #93a199;
  font-size: 21rpx;
  text-align: center;
}
